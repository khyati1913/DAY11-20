Q31: Write a program to take a number as input and print its equivalent binary representation.

/*
Sample Test Cases:
Input 1:
10
Output 1:
1010

Input 2:
7
Output 2:
111

*/




#include <stdio.h>

int main() {
    unsigned int n;
    if (scanf("%u", &n) != 1) {
        return 1;
    }

    if (n == 0) {
        printf("0\n");
        return 0;
    }

    // Store bits in an array (or you can use a string)
    char bin[32 + 1];  // enough for 32-bit integer + null
    bin[32] = '\0';     // null terminator
    int idx = 32;

    while (n > 0) {
        idx--;
        bin[idx] = (n % 2) ? '1' : '0';
        n = n / 2;
    }

    // Print from bin[idx] to end
    printf("%s\n", &bin[idx]);

    return 0;
}
