Q40: Write a program to find the 1’s complement of a binary number and print it.

/*
Sample Test Cases:
Input 1:
1010
Output 1:
0101

Input 2:
1111
Output 2:
0000

*/


#include <stdio.h>
#include <string.h>

int main() {
    char binary[65];  // Array to store the binary number
    scanf("%s", binary);

    // Loop through each character in the binary string
    for (int i = 0; i < strlen(binary); i++) {
        // Flip '1' to '0' and '0' to '1'
        if (binary[i] == '1') {
            binary[i] = '0';
        } else if (binary[i] == '0') {
            binary[i] = '1';
        }
    }

    // Output the 1's complement
    printf("%s\n", binary);
    return 0;
}
