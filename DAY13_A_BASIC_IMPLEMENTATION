Q25: Write a program to implement a basic calculator using switch-case for +, -, *, /, %.

/*
Sample Test Cases:
Input 1:
4 2 +
Output 1:
6

Input 2:
10 3 %
Output 2:
1

Input 3:
15 5 /
Output 3:
3

*/BAS
#include <stdio.h>

int main() {
    int a, b;
    char op;

    // Read input: two integers and an operator
    if (scanf("%d %d %c", &a, &b, &op) != 3) {
        printf("Invalid input\n");
        return 1;
    }

    switch (op) {
        case '+':
            printf("%d\n", a + b);
            break;
        case '-':
            printf("%d\n", a - b);
            break;
        case '*':
            printf("%d\n", a * b);
            break;
        case '/':
            if (b == 0) {
                printf("Error: Division by zero\n");
            } else {
                printf("%d\n", a / b);
            }
            break;
        case '%':
            if (b == 0) {
                printf("Error: Modulo by zero\n");
            } else {
                printf("%d\n", a % b);
            }
            break;
        default:
            printf("Unsupported operator\n");
    }

    return 0;
}
