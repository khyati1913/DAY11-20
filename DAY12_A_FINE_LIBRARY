#include <stdio.h>

int main() {
    int days;
    printf("Enter number of late days: ");
    if (scanf("%d", &days) != 1) {
        printf("Invalid input\n");
        return 1;
    }

    if (days > 30) {
        // More than 30 days: membership cancelled
        printf("Membership Cancelled\n");
    } else {
        int fine = 0;
        if (days > 0) {
            int d = days;
            // first 5 days
            if (d <= 5) {
                fine += d * 2;
                d = 0;
            } else {
                fine += 5 * 2;
                d -= 5;
            }
            // next 5 days (days 6–10)
            if (d > 0) {
                if (d <= 5) {
                    fine += d * 4;
                    d = 0;
                } else {
                    fine += 5 * 4;
                    d -= 5;
                }
            }
            // next up to 20 days (days 11–30)
            if (d > 0) {
                // d could be up to 20 now
                fine += d * 6;
            }
        }
        printf("Fine ₹%d\n", fine);
    }

    return 0;
}
