Q36: Write a program to find the HCF (GCD) of two numbers.

/*
Sample Test Cases:
Input 1:
12 18
Output 1:
6

Input 2:
7 9
Output 2:
1

*/


#include <stdio.h>

int main() {
    int num1, num2;

    // Input two integers
    scanf("%d %d", &num1, &num2);

    // Implementing Euclidean algorithm
    while (num1 != num2) {
        if (num1 > num2)
            num1 -= num2;
        else
            num2 -= num1;
    }

    // Output the HCF
    printf("%d\n", num1);

    return 0;
}


